# Copy to outreach-local/.env (gitignored) and fill in.
# Uses the same hosted Supabase project as production API.

APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_PRETTY_FILE_ENABLED=false

DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://YOUR_REF.supabase.co/auth/v1

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Sheets outreach pipeline
GOOGLE_SHEETS_SPREADSHEET_ID=
# Inline JSON starting with { or a local file path
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# How often to poll the sheet when running ./run.sh (seconds)
OUTREACH_POLL_INTERVAL_SECONDS=300
# Stores provisioned per tick (default 1)
DEMO_PROVISION_MAX_JOBS_PER_TICK=1
# Pause between storefront HTTP requests (seconds)
DEMO_STORE_FETCH_DELAY_SECONDS=1.0
