# Monorepo-wide ignores

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files
.env
.env.*
!.env.example

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Local binaries/artifacts
*.deb

# Logs
*.log
logs/

# Local-only outreach worker (copy from outreach-local.example/)
outreach-local/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
