APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- Hosted Supabase (match the same project as app NEXT_PUBLIC_SUPABASE_URL) ---
# Database: Dashboard → Settings → Database → URI (use pooler or direct; async driver needs postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# --- Local Supabase only (comment hosted lines above and use these) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1

# Optional for runtime features that call OpenAI.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Development-only: requests *without* Authorization map to this user (curl / local tools).
# Keep false when testing multi-account login in the app — otherwise missing tokens all share one DB user.
DEV_AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_USER_ID=00000000-0000-0000-0000-000000000001

# Shopify Partner app (OAuth). Callback URL in Partners must match:
# {PUBLIC_API_BASE_URL}/api/v1/integrations/shopify/oauth/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional override; default matches read-only support scopes.
# SHOPIFY_SCOPES=read_customers,read_fulfillments,read_inventory,read_orders,read_products
SHOPIFY_API_VERSION=2026-04
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
SHOPIFY_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/actions
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_FERNET_KEY=
# Random string (32+ chars) for signing OAuth state.
INTEGRATION_OAUTH_STATE_SECRET=

# Mailjet (optional): transactional send + Parse inbound webhook.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_SENDER_EMAIL=
# MAILJET_SENDER_NAME=Support
# Domain on your Mailjet Parse route for Reply-To addresses (e.g. inbox.example.com).
# MAILJET_INBOUND_DOMAIN=
# MAILJET_REPLY_HMAC_SECRET=
# Query param secret for POST /api/v1/integrations/mailjet/inbound?verify=
# MAILJET_INBOUND_WEBHOOK_SECRET=

# Stripe (test mode). Use `stripe listen --forward-to .../api/v1/webhooks/stripe` for local whsec_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring Price IDs must start with price_ (create under each Product in Dashboard).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
# Optional; Scale tier is off public pricing by default.
# STRIPE_PRICE_SCALE_MONTHLY=
BILLING_APP_BASE_URL=http://localhost:3000
# Optional: protect POST /api/v1/billing/internal/charge-overage
# BILLING_INTERNAL_SECRET=

# Comma-separated emails authorized to access /api/v1/admin/*. Leave empty to disable the admin panel.
# Match against the JWT email claim (case-insensitive). Admins type /admin to access the panel.
# ADMIN_EMAILS=alice@chatrely.com,bob@chatrely.com

# --- Admin Costing: per-model token pricing in USD per 1,000,000 tokens ---
# JSON object keyed by the literal `messages.model` value. Edit + restart to add a new model.
# Models present in messages but missing here surface as "unknown_models" on /admin/costing.
# Sample values are current public OpenAI list prices; verify before relying on them.
LLM_INPUT_PRICE_PER_MILLION_USD={"gpt-4o-mini":0.15,"gpt-4o":2.50,"gpt-4-turbo":10.0}
LLM_OUTPUT_PRICE_PER_MILLION_USD={"gpt-4o-mini":0.60,"gpt-4o":10.0,"gpt-4-turbo":30.0}
# Keyed by embedding model (must include OPENAI_EMBEDDING_MODEL above to price chunks).
EMBEDDING_PRICE_PER_MILLION_USD={"text-embedding-3-small":0.02,"text-embedding-3-large":0.13,"text-embedding-ada-002":0.10}
