# --- Hosted Supabase (default for this team flow: Auth providers live in the cloud dashboard) ---
# Dashboard → Project Settings → API: Project URL + anon / publishable key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# If your dashboard only shows "anon" JWT, use this instead (omit empty PUBLISHABLE_KEY line):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: set when frontend should call backend directly instead of Next rewrites.
NEXT_PUBLIC_BACKEND_URL=

# Optional: absolute URL to widget.js (CDN or static host). If unset, embed snippet uses /widget.js on this app origin.
# After `cd widget && npm run build`, copy `widget/dist/widget.js` to `app/public/widget.js`.
# NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://cdn.example.com/widget.js

# Optional server-side API target overrides for Next.js rewrites/SSR.
API_PROXY_TARGET=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Local Google OAuth (Supabase CLI): put credentials in the repository **root** `.env` (not app/.env).
# Names must not start with SUPABASE_ (CLI ignores them). Use GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.

# --- Local Supabase only (supabase start): uncomment and comment hosted vars above ---
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
