# --- Hosted Supabase (default for this team flow: Auth providers live in the cloud dashboard) ---
# Dashboard → Project Settings → API: Project URL + anon / publishable key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# If your dashboard only shows "anon" JWT, use this instead (omit empty PUBLISHABLE_KEY line):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical public URL (password reset emails, OAuth redirects). If unset, Host / X-Forwarded-* headers are used.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Optional: set when frontend should call backend directly instead of Next rewrites.
NEXT_PUBLIC_BACKEND_URL=

# Site-wide product chatbot (dogfood widget on marketing, auth, dashboard, etc.)
# Run: cd backend && uv run python scripts/seed_platform_site_agent.py --email you@example.com
# NEXT_PUBLIC_CHATRELY_SITE_AGENT_KEY=pk_...
# NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://app.example.com/widget.js

# Optional server-side API target overrides for Next.js rewrites/SSR.
API_PROXY_TARGET=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
